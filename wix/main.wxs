<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>

    <Product
        Id='*'
        Name='Devoid Viewer'
        UpgradeCode='42131F52-0DFF-4B4C-868B-4656FD6F3F89'
        Manufacturer='Fatih Cihan Hizlikan'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='Devoid Viewer: A minimalist, high-performance image viewer.'
            Manufacturer='Fatih Cihan Hizlikan'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252'/>

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes'/>

        <Icon Id='ProductICO' SourceFile='devoid.ico'/>
        <Property Id='ARPPRODUCTICON' Value='ProductICO'/>
        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='$(var.PlatformProgramFilesFolder)'>
                <Directory Id='APPLICATIONFOLDER' Name='Devoid Viewer'>

                    <!-- Main executable -->
                    <Component Id='binary0' Guid='*'>
                        <File
                            Id='exe0'
                            Name='DevoidViewer.exe'
                            DiskId='1'
                            Source='$(var.CargoTargetBinDir)\DevoidViewer.exe'
                            KeyPath='yes'/>
                    </Component>

                    <!-- ProgId registration: shared by both association components.
                         Registers the application identifier, launch command, and icon.
                         Installed as part of the core application — always present. -->
                    <Component Id='ProgIdRegistration' Guid='C2D3E4F5-A6B7-4C8D-9E0F-1A2B3C4D5E6F'>
                        <RegistryValue Id='reg_ProgId'       Root='HKCR' Key='DevoidViewer.ImageFile'                        Type='string' Value='Image File' KeyPath='yes'/>
                        <RegistryValue Id='reg_ProgId_open'  Root='HKCR' Key='DevoidViewer.ImageFile\shell\open\command'     Type='string' Value='"[APPLICATIONFOLDER]DevoidViewer.exe" "%1"'/>
                        <RegistryValue Id='reg_ProgId_icon'  Root='HKCR' Key='DevoidViewer.ImageFile\DefaultIcon'            Type='string' Value='"[APPLICATIONFOLDER]DevoidViewer.exe",0'/>
                    </Component>

                    <!-- Open With: adds Devoid Viewer to the "Open With" list for all
                         supported formats without overriding the user's existing defaults.
                         Installed by default, can be deselected. -->
                    <Component Id='OpenWithAssociations' Guid='D3E4F5A6-B7C8-4D9E-0F1A-2B3C4D5E6F7A'>
                        <RegistryValue Id='reg_owp_jpg'   Root='HKCR' Key='.jpg\OpenWithProgIds\DevoidViewer.ImageFile'   Type='string' Value='' KeyPath='yes'/>
                        <RegistryValue Id='reg_owp_jpeg'  Root='HKCR' Key='.jpeg\OpenWithProgIds\DevoidViewer.ImageFile'  Type='string' Value=''/>
                        <RegistryValue Id='reg_owp_png'   Root='HKCR' Key='.png\OpenWithProgIds\DevoidViewer.ImageFile'   Type='string' Value=''/>
                        <RegistryValue Id='reg_owp_bmp'   Root='HKCR' Key='.bmp\OpenWithProgIds\DevoidViewer.ImageFile'   Type='string' Value=''/>
                        <RegistryValue Id='reg_owp_gif'   Root='HKCR' Key='.gif\OpenWithProgIds\DevoidViewer.ImageFile'   Type='string' Value=''/>
                        <RegistryValue Id='reg_owp_webp'  Root='HKCR' Key='.webp\OpenWithProgIds\DevoidViewer.ImageFile'  Type='string' Value=''/>
                        <RegistryValue Id='reg_owp_tiff'  Root='HKCR' Key='.tiff\OpenWithProgIds\DevoidViewer.ImageFile'  Type='string' Value=''/>
                        <RegistryValue Id='reg_owp_tif'   Root='HKCR' Key='.tif\OpenWithProgIds\DevoidViewer.ImageFile'   Type='string' Value=''/>
                        <RegistryValue Id='reg_owp_ico'   Root='HKCR' Key='.ico\OpenWithProgIds\DevoidViewer.ImageFile'   Type='string' Value=''/>
                        <RegistryValue Id='reg_owp_jxl'   Root='HKCR' Key='.jxl\OpenWithProgIds\DevoidViewer.ImageFile'   Type='string' Value=''/>
                        <RegistryValue Id='reg_owp_svg'   Root='HKCR' Key='.svg\OpenWithProgIds\DevoidViewer.ImageFile'   Type='string' Value=''/>
                    </Component>

                    <!-- Set as Default: makes Devoid Viewer the default opener for all
                         supported formats. Opt-in — unchecked by default so existing
                         default associations (e.g. Windows Photos for .jpg) are preserved
                         unless the user explicitly chooses this option. -->
                    <Component Id='DefaultAssociations' Guid='E4F5A6B7-C8D9-4E0F-1A2B-3C4D5E6F7A8B'>
                        <RegistryValue Id='reg_def_jpg'   Root='HKCR' Key='.jpg'   Type='string' Value='DevoidViewer.ImageFile' KeyPath='yes'/>
                        <RegistryValue Id='reg_def_jpeg'  Root='HKCR' Key='.jpeg'  Type='string' Value='DevoidViewer.ImageFile'/>
                        <RegistryValue Id='reg_def_png'   Root='HKCR' Key='.png'   Type='string' Value='DevoidViewer.ImageFile'/>
                        <RegistryValue Id='reg_def_bmp'   Root='HKCR' Key='.bmp'   Type='string' Value='DevoidViewer.ImageFile'/>
                        <RegistryValue Id='reg_def_gif'   Root='HKCR' Key='.gif'   Type='string' Value='DevoidViewer.ImageFile'/>
                        <RegistryValue Id='reg_def_webp'  Root='HKCR' Key='.webp'  Type='string' Value='DevoidViewer.ImageFile'/>
                        <RegistryValue Id='reg_def_tiff'  Root='HKCR' Key='.tiff'  Type='string' Value='DevoidViewer.ImageFile'/>
                        <RegistryValue Id='reg_def_tif'   Root='HKCR' Key='.tif'   Type='string' Value='DevoidViewer.ImageFile'/>
                        <RegistryValue Id='reg_def_ico'   Root='HKCR' Key='.ico'   Type='string' Value='DevoidViewer.ImageFile'/>
                        <RegistryValue Id='reg_def_jxl'   Root='HKCR' Key='.jxl'   Type='string' Value='DevoidViewer.ImageFile'/>
                        <RegistryValue Id='reg_def_svg'   Root='HKCR' Key='.svg'   Type='string' Value='DevoidViewer.ImageFile'/>
                    </Component>

                    <!-- Desktop shortcut -->
                    <Component Id='ApplicationShortcut' Guid='A1B2C3D4-E5F6-7890-ABCD-EF1234567890'>
                        <Shortcut Id='DesktopShortcut'
                            Directory='DesktopFolder'
                            Name='Devoid Viewer'
                            Target='[APPLICATIONFOLDER]DevoidViewer.exe'
                            WorkingDirectory='APPLICATIONFOLDER'
                            Icon='ProductICO'/>
                        <RemoveFolder Id='RemoveDesktopFolder' Directory='DesktopFolder' On='uninstall'/>
                        <RegistryValue Id='reg_shortcut' Root='HKCU' Key='Software\DevoidViewer' Type='integer' Value='1' KeyPath='yes'/>
                    </Component>

                </Directory>
            </Directory>

            <Directory Id='DesktopFolder'/>
        </Directory>

        <!-- Refresh shell icon cache so file type icons appear immediately -->
        <CustomAction
            Id='RefreshShellIcons'
            Directory='TARGETDIR'
            ExeCommand='[SystemFolder]ie4uinit.exe -ClearIconCache'
            Execute='immediate'
            Return='ignore'/>

        <InstallExecuteSequence>
            <Custom Action='RefreshShellIcons' After='InstallFinalize'>NOT Installed OR REMOVE</Custom>
        </InstallExecuteSequence>

        <Feature
            Id='Binaries'
            Title='Application'
            Description='Installs the Devoid Viewer executable.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>
            <ComponentRef Id='binary0'/>
            <ComponentRef Id='ProgIdRegistration'/>

            <!-- Open With: checked by default, can be deselected -->
            <Feature
                Id='OpenWith'
                Title='Add to Open With'
                Description='Add Devoid Viewer to the Open With menu for all supported image formats (jpg, png, gif, webp, svg, jxl and more). Your existing default image viewer is not changed.'
                Level='1'
                Absent='allow'>
                <ComponentRef Id='OpenWithAssociations'/>
            </Feature>

            <!-- Set as Default: unchecked by default (Level=2), opt-in -->
            <Feature
                Id='DefaultViewer'
                Title='Set as Default Image Viewer'
                Description='Make Devoid Viewer the default application for all supported image formats. This will replace your current default image viewer (e.g. Windows Photos).'
                Level='1'
                Absent='allow'>
                <ComponentRef Id='DefaultAssociations'/>
            </Feature>

            <!-- Desktop shortcut: checked by default, can be deselected -->
            <Feature
                Id='DesktopShortcut'
                Title='Desktop Shortcut'
                Description='Add a shortcut to Devoid Viewer on the desktop.'
                Level='1'
                Absent='allow'>
                <ComponentRef Id='ApplicationShortcut'/>
            </Feature>

        </Feature>

        <UI>
            <UIRef Id='WixUI_FeatureTree'/>
            <Publish Dialog='WelcomeDlg' Control='Next' Event='NewDialog' Value='CustomizeDlg' Order='99'>1</Publish>
            <Publish Dialog='CustomizeDlg' Control='Back' Event='NewDialog' Value='WelcomeDlg' Order='99'>1</Publish>
        </UI>

    </Product>

</Wix>
