<!--
  Please do not remove these pre-processor If-Else blocks. These are used with
  the `cargo wix` subcommand to automatically determine the installation
  destination for 32-bit versus 64-bit installers. Removal of these lines will
  cause installation errors.
-->
<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>

    <Product
        Id='*'
        Name='Devoid Viewer'
        UpgradeCode='42131F52-0DFF-4B4C-868B-4656FD6F3F89'
        Manufacturer='Fatih Cihan Hizlikan'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='Devoid Viewer: A minimalist, high-performance image viewer.'
            Manufacturer='Fatih Cihan Hizlikan'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252'
            />

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes'/>

        <!-- Product icon shown in Add/Remove Programs -->
        <Icon Id='ProductICO' SourceFile='devoid.ico'/>
        <Property Id='ARPPRODUCTICON' Value='ProductICO'/>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='$(var.PlatformProgramFilesFolder)'>
                <Directory Id='APPLICATIONFOLDER' Name='Devoid Viewer'>

                    <!-- Main executable -->
                    <Component Id='binary0' Guid='*'>
                        <File
                            Id='exe0'
                            Name='DevoidViewer.exe'
                            DiskId='1'
                            Source='$(var.CargoTargetBinDir)\DevoidViewer.exe'
                            KeyPath='yes'/>
                    </Component>

                    <!-- File associations: all formats supported by Devoid Viewer -->
                    <Component Id='FileAssociations' Guid='B3C1A2D4-9E7F-4A3B-8C6D-1E2F3A4B5C6D'>
                        <ProgId Id='DevoidViewer.ImageFile'
                                Description='Image file'
                                Icon='exe0'
                                IconIndex='0'
                                Advertise='no'>
                            <Extension Id='jpg'  ContentType='image/jpeg'>
                                <Verb Id='open' Command='Open' TargetFile='exe0' Argument='"%1"'/>
                            </Extension>
                            <Extension Id='jpeg' ContentType='image/jpeg'>
                                <Verb Id='open' Command='Open' TargetFile='exe0' Argument='"%1"'/>
                            </Extension>
                            <Extension Id='png'  ContentType='image/png'>
                                <Verb Id='open' Command='Open' TargetFile='exe0' Argument='"%1"'/>
                            </Extension>
                            <Extension Id='bmp'  ContentType='image/bmp'>
                                <Verb Id='open' Command='Open' TargetFile='exe0' Argument='"%1"'/>
                            </Extension>
                            <Extension Id='gif'  ContentType='image/gif'>
                                <Verb Id='open' Command='Open' TargetFile='exe0' Argument='"%1"'/>
                            </Extension>
                            <Extension Id='webp' ContentType='image/webp'>
                                <Verb Id='open' Command='Open' TargetFile='exe0' Argument='"%1"'/>
                            </Extension>
                            <Extension Id='tiff' ContentType='image/tiff'>
                                <Verb Id='open' Command='Open' TargetFile='exe0' Argument='"%1"'/>
                            </Extension>
                            <Extension Id='tif'  ContentType='image/tiff'>
                                <Verb Id='open' Command='Open' TargetFile='exe0' Argument='"%1"'/>
                            </Extension>
                            <Extension Id='ico'  ContentType='image/x-icon'>
                                <Verb Id='open' Command='Open' TargetFile='exe0' Argument='"%1"'/>
                            </Extension>
                            <Extension Id='jxl'  ContentType='image/jxl'>
                                <Verb Id='open' Command='Open' TargetFile='exe0' Argument='"%1"'/>
                            </Extension>
                            <Extension Id='svg'  ContentType='image/svg+xml'>
                                <Verb Id='open' Command='Open' TargetFile='exe0' Argument='"%1"'/>
                            </Extension>
                        </ProgId>
                    </Component>

                    <!-- Desktop shortcut.
                         CreateFolder on APPLICATIONFOLDER is the KeyPath — avoids
                         any registry key collision with the FileAssociations component. -->
                    <Component Id='ApplicationShortcut' Guid='A1B2C3D4-E5F6-7890-ABCD-EF1234567890'>
                        <Shortcut Id='DesktopShortcut'
                            Directory='DesktopFolder'
                            Name='Devoid Viewer'
                            Target='[APPLICATIONFOLDER]DevoidViewer.exe'
                            WorkingDirectory='APPLICATIONFOLDER'
                            Icon='ProductICO'/>
                        <RemoveFolder Id='RemoveDesktopFolder' Directory='DesktopFolder' On='uninstall'/>
                        <CreateFolder Directory='APPLICATIONFOLDER' KeyPath='yes'/>
                    </Component>

                </Directory>
            </Directory>

            <!-- Required for desktop shortcut -->
            <Directory Id='DesktopFolder'/>
        </Directory>

        <!-- Refresh shell icon cache so file type icons appear immediately -->
        <CustomAction
            Id='RefreshShellIcons'
            Directory='TARGETDIR'
            ExeCommand='[SystemFolder]ie4uinit.exe -ClearIconCache'
            Execute='deferred'
            Impersonate='no'
            Return='ignore'/>

        <InstallExecuteSequence>
            <Custom Action='RefreshShellIcons' After='InstallFinalize'>NOT Installed OR REMOVE</Custom>
        </InstallExecuteSequence>

        <Feature
            Id='Binaries'
            Title='Application'
            Description='Installs the Devoid Viewer executable and file associations.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>

            <ComponentRef Id='binary0'/>
            <ComponentRef Id='FileAssociations'/>

            <Feature
                Id='DesktopShortcut'
                Title='Desktop Shortcut'
                Description='Add a shortcut to Devoid Viewer on the desktop.'
                Level='1'
                Absent='allow'>
                <ComponentRef Id='ApplicationShortcut'/>
            </Feature>

        </Feature>

        <UI>
            <UIRef Id='WixUI_FeatureTree'/>
            <Publish Dialog='WelcomeDlg' Control='Next' Event='NewDialog' Value='CustomizeDlg' Order='99'>1</Publish>
            <Publish Dialog='CustomizeDlg' Control='Back' Event='NewDialog' Value='WelcomeDlg' Order='99'>1</Publish>
        </UI>

    </Product>

</Wix>
